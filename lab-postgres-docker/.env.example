# Copiar a .env y completar con valores reales. .env nunca se sube al repositorio.

# Cuando la app corre directamente sobre el host:
# DB_HOST=localhost
# Cuando la app corre dentro del contenedor Docker:
# DB_HOST=host.docker.internal

DB_HOST=localhost
DB_PORT=5432
DB_NAME=labdb
DB_USER=labapp
DB_PASSWORD=cambiar_esta_password

PORT=3000
